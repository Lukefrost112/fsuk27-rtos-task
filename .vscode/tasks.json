{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake --build --preset Debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash",
      "type": "shell",
      "command": "openocd -f interface/stlink.cfg -f target/stm32f1x.cfg -c \"program build/Debug/rtos-task.elf verify reset exit\"",
      "dependsOn": "Build",
      "problemMatcher": []
    }
  ]
}